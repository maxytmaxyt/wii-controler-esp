# Bluetooth Classic (BR/EDR) - enable full BT stack
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=n

# CRITICAL: Disable SSP — the Wii uses Legacy Pairing with raw binary PINs.
# If SSP is active, Bluedroid forces modern key negotiation and the Wii
# immediately drops the connection.
CONFIG_BT_SSP_ENABLED=n
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE off - we only need Classic
CONFIG_BT_BLE_ENABLED=n
CONFIG_GATTS_ENABLE=n
CONFIG_GATTC_ENABLE=n
CONFIG_BLE_MESH=n

# HID device profile handles HID SDP and L2CAP channels.
CONFIG_BT_HID_HOST_ENABLED=n

# Bluedroid stack
CONFIG_BT_BLUEDROID_ENABLED=y

# NVS needed for link key persistence
CONFIG_NVS_ENCRYPTION=n

# Stack sizes
CONFIG_BT_BTC_TASK_STACK_SIZE=8192

# FIX: HID BT task stack — 2048 (default) is too small for the full
# GAP/PIN/SDP connection sequence and causes stack overflows on pairing.
# 4096 gives comfortable headroom.
CONFIG_ESPHID_TASK_SIZE_BT=4096

# FIX: Custom partition table — without these entries PlatformIO's IDF
# build ignores partitions_wiimote.csv and falls back to the single-app
# default, leaving no room for the BT stack's NVS namespace.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_wiimote.csv"

# Logging
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
